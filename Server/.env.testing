# Loaded by `swift test` (Vapor's .testing environment) ahead of .env, so
# these values win. The test suite migrates and then *reverts* every
# migration around each test, so it must never point at the dev database
# `swift run App serve` uses -- before this file existed it did, and every
# `swift test` run wiped all dev data. configure.swift refuses to run the
# tests against any database whose name doesn't end in "_test".
#
# The database itself: docker-compose.yml creates it on a fresh volume
# (docker/initdb/). On an existing volume, create it once with:
#   docker compose exec db createdb -U vapor_username expatevents_test
DATABASE_NAME=expatevents_test
