# Copy to .env and fill in. Vapor loads .env automatically in development
# (see README). Never commit the real .env file — it's gitignored.

# --- Database (M1) ---------------------------------------------------------
# Either set DATABASE_URL (as DigitalOcean Managed Postgres hands it out —
# include ?sslmode=require for DO) ...
# DATABASE_URL=postgres://user:password@host:25060/expatevents?sslmode=require
#
# ... or the individual local-dev variables (matches docker-compose.yml):
DATABASE_HOST=localhost
# 5433, not Postgres's usual 5432 — see docker-compose.yml's comment on the
# `db` service's port mapping for why (avoids colliding with any other
# Postgres already listening on your machine's 5432).
DATABASE_PORT=5433
DATABASE_USERNAME=vapor_username
DATABASE_PASSWORD=vapor_password
DATABASE_NAME=expatevents

# --- Sessions & tokens (M2) -------------------------------------------------
# Any long random string. Required in production; a development-only
# default is used if unset (configure.swift logs a warning).
JWT_SECRET=change-me-to-a-long-random-string

# --- Sign in with Apple / Google (M2) ---------------------------------------
# Apple: the Services ID configured for "Sign in with Apple" (web).
APPLE_CLIENT_ID=
# Google: the OAuth web client ID from the Google Cloud console.
GOOGLE_CLIENT_ID=

# --- Stripe (M8 — not yet implemented) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- DigitalOcean Spaces (file storage, M13 — not yet implemented) ---------
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_BUCKET=
SPACES_REGION=fra1
