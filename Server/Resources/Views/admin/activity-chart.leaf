<div id="admin-activity" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-[15px] font-semibold text-slate-900">Sign-ups &amp; events</h2>
            <p class="text-xs text-slate-500">#(activity.totalAccounts) new accounts · #(activity.totalEvents) events created · #(activity.rangeLabel)</p>
        </div>
        <div class="flex rounded-lg bg-slate-100 p-0.5 text-xs font-semibold" role="group" aria-label="Chart range">
            #if(activity.isFourWeeks):
            <button type="button" class="rounded-md bg-white px-2.5 py-1 text-slate-900 shadow-sm" aria-pressed="true">4w</button>
            #else:
            <button type="button" class="rounded-md px-2.5 py-1 text-slate-500 hover:text-slate-800" aria-pressed="false" hx-get="/admin/activity?range=4w" hx-target="\#admin-activity" hx-swap="outerHTML">4w</button>
            #endif
            #if(activity.isTwelveWeeks):
            <button type="button" class="rounded-md bg-white px-2.5 py-1 text-slate-900 shadow-sm" aria-pressed="true">12w</button>
            #else:
            <button type="button" class="rounded-md px-2.5 py-1 text-slate-500 hover:text-slate-800" aria-pressed="false" hx-get="/admin/activity?range=12w" hx-target="\#admin-activity" hx-swap="outerHTML">12w</button>
            #endif
            #if(activity.isYear):
            <button type="button" class="rounded-md bg-white px-2.5 py-1 text-slate-900 shadow-sm" aria-pressed="true">1y</button>
            #else:
            <button type="button" class="rounded-md px-2.5 py-1 text-slate-500 hover:text-slate-800" aria-pressed="false" hx-get="/admin/activity?range=1y" hx-target="\#admin-activity" hx-swap="outerHTML">1y</button>
            #endif
        </div>
    </div>
    <svg viewBox="0 0 640 200" class="h-auto w-full" role="img" aria-label="New accounts and events created, #(activity.rangeLabel)">
        #for(tick in activity.ticks):
        <line x1="40" x2="630" y1="#(tick.y)" y2="#(tick.y)" class="stroke-slate-200" stroke-width="1"/>
        <text x="32" y="#(tick.labelY)" text-anchor="end" class="fill-slate-400" font-size="11">#(tick.text)</text>
        #endfor
        #for(bar in activity.bars):
        <rect x="#(bar.x)" y="#(bar.y)" width="#(bar.width)" height="#(bar.height)" rx="3" class="fill-violet-200"><title>#(bar.title)</title></rect>
        #endfor
        <polyline points="#(activity.linePoints)" fill="none" class="stroke-teal-600" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
        #for(point in activity.points):
        <circle cx="#(point.x)" cy="#(point.y)" r="3" class="fill-white stroke-teal-600" stroke-width="2"><title>#(point.title)</title></circle>
        #endfor
        #for(label in activity.xLabels):
        <text x="#(label.x)" y="196" text-anchor="middle" class="fill-slate-400" font-size="11">#(label.text)</text>
        #endfor
    </svg>
    <div class="mt-2 flex gap-4 text-xs text-slate-500">
        <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-teal-600"></span>New accounts</span>
        <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-violet-200"></span>Events created</span>
    </div>
</div>
