<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#(title) — ExpatEvents</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: { DEFAULT: 'rgb(24 42 115)', light: 'rgb(45 63 143)' },
                        accent: { DEFAULT: 'rgb(31 154 163)', dark: 'rgb(26 134 142)', soft: 'rgb(226 244 245)' }
                    }
                }
            }
        };
    </script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>[x-cloak]{display:none !important;}</style>
</head>
<body class="h-full text-slate-800 antialiased" x-data="{ menu: false }" @keydown.escape.window="menu = false">
<div class="min-h-full lg:grid lg:grid-cols-[240px_1fr]">
    <aside class="fixed inset-y-0 left-0 z-40 w-60 -translate-x-full transform bg-brand text-indigo-100 transition-transform duration-200 lg:sticky lg:top-0 lg:h-screen lg:w-auto lg:translate-x-0"
           :style="menu ? 'transform: translateX(0)' : ''" aria-label="Admin navigation">
        <div class="flex h-full flex-col px-3 py-5">
            <a href="/admin" class="mb-6 flex items-center gap-2.5 px-2.5 text-[15px] font-bold text-white">
                <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-sky-500 to-teal-400 text-xs">EE</span>
                ExpatEvents Admin
            </a>
            <nav class="flex flex-col gap-0.5 text-sm font-medium">
                #if(chrome.nav.dashboard):
                <a href="/admin" aria-current="page" class="flex items-center gap-3 rounded-lg bg-white/15 px-2.5 py-2 text-white shadow-[inset_3px_0_0_rgb(45_212_191)]">
                #else:
                <a href="/admin" class="flex items-center gap-3 rounded-lg px-2.5 py-2 hover:bg-white/10 hover:text-white">
                #endif
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    Dashboard
                </a>

                <div class="px-2.5 pb-1.5 pt-4 text-[11px] font-semibold uppercase tracking-wider text-indigo-300/70">Manage</div>
                #if(chrome.nav.users):
                <a href="/admin/users" aria-current="page" class="flex items-center gap-3 rounded-lg bg-white/15 px-2.5 py-2 text-white shadow-[inset_3px_0_0_rgb(45_212_191)]">
                #else:
                <a href="/admin/users" class="flex items-center gap-3 rounded-lg px-2.5 py-2 hover:bg-white/10 hover:text-white">
                #endif
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.8c1.7.8 2.8 2.6 3.2 5.2"/></svg>
                    Users
                </a>
                #if(chrome.nav.events):
                <a href="/admin/events" aria-current="page" class="flex items-center gap-3 rounded-lg bg-white/15 px-2.5 py-2 text-white shadow-[inset_3px_0_0_rgb(45_212_191)]">
                #else:
                <a href="/admin/events" class="flex items-center gap-3 rounded-lg px-2.5 py-2 hover:bg-white/10 hover:text-white">
                #endif
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/></svg>
                    Events
                </a>
                #if(chrome.nav.groups):
                <a href="/admin/groups" aria-current="page" class="flex items-center gap-3 rounded-lg bg-white/15 px-2.5 py-2 text-white shadow-[inset_3px_0_0_rgb(45_212_191)]">
                #else:
                <a href="/admin/groups" class="flex items-center gap-3 rounded-lg px-2.5 py-2 hover:bg-white/10 hover:text-white">
                #endif
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="3"/><circle cx="5" cy="11" r="2.2"/><circle cx="19" cy="11" r="2.2"/><path d="M6.5 20c.6-3 2.9-5 5.5-5s4.9 2 5.5 5M1.8 18.5c.4-1.8 1.6-3 3.2-3M22.2 18.5c-.4-1.8-1.6-3-3.2-3"/></svg>
                    Groups
                </a>

                <div class="px-2.5 pb-1.5 pt-4 text-[11px] font-semibold uppercase tracking-wider text-indigo-300/70">Money &amp; compliance</div>
                #if(chrome.nav.billing):
                <a href="/admin/billing" aria-current="page" class="flex items-center gap-3 rounded-lg bg-white/15 px-2.5 py-2 text-white shadow-[inset_3px_0_0_rgb(45_212_191)]">
                #else:
                <a href="/admin/billing" class="flex items-center gap-3 rounded-lg px-2.5 py-2 hover:bg-white/10 hover:text-white">
                #endif
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 10h19M6 15h4"/></svg>
                    Billing
                </a>
                #if(chrome.nav.dataRequests):
                <a href="/admin/data-requests" aria-current="page" class="flex items-center gap-3 rounded-lg bg-white/15 px-2.5 py-2 text-white shadow-[inset_3px_0_0_rgb(45_212_191)]">
                #else:
                <a href="/admin/data-requests" class="flex items-center gap-3 rounded-lg px-2.5 py-2 hover:bg-white/10 hover:text-white">
                #endif
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 4 6v6c0 4.8 3.4 8.4 8 9.5 4.6-1.1 8-4.7 8-9.5V6z"/><path d="m9 12 2 2 4-4"/></svg>
                    Data requests
                    #if(chrome.hasPendingDeletions):
                    <span class="ml-auto rounded-full bg-rose-500 px-2 py-0.5 text-[11px] font-bold text-white" aria-label="pending deletion requests">#(chrome.pendingDeletions)</span>
                    #endif
                </a>
                #if(chrome.nav.auditLog):
                <a href="/admin/audit-log" aria-current="page" class="flex items-center gap-3 rounded-lg bg-white/15 px-2.5 py-2 text-white shadow-[inset_3px_0_0_rgb(45_212_191)]">
                #else:
                <a href="/admin/audit-log" class="flex items-center gap-3 rounded-lg px-2.5 py-2 hover:bg-white/10 hover:text-white">
                #endif
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2.5H6a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8.5z"/><path d="M14 2.5v6h6M8 13h8M8 17h5"/></svg>
                    Audit log
                </a>
            </nav>
            <div class="mt-auto border-t border-white/10 px-2.5 pt-4 text-xs">
                <div class="flex items-center gap-2.5">
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-light text-xs font-bold text-white">#(chrome.adminInitials)</span>
                    <div class="min-w-0">
                        <div class="truncate text-sm font-semibold text-white">#(chrome.adminName)</div>
                        <a href="/events" class="text-indigo-200 underline-offset-2 hover:underline">Back to site</a>
                    </div>
                </div>
                <p class="mt-3 text-[11px] leading-snug text-indigo-300/70">Every change is recorded in the audit log.</p>
            </div>
        </div>
    </aside>
    <div x-cloak x-show="menu" @click="menu = false" class="fixed inset-0 z-30 bg-slate-900/40 lg:hidden"></div>

    <div class="min-w-0">
        <header class="sticky top-0 z-20 flex items-center gap-3 border-b border-slate-200 bg-white/90 px-4 py-3 backdrop-blur lg:hidden">
            <button type="button" @click="menu = !menu" :aria-expanded="menu.toString()" aria-expanded="false" class="rounded-lg border border-slate-200 p-2" aria-label="Open the admin menu">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <span class="font-semibold">ExpatEvents Admin</span>
        </header>
        <main class="mx-auto max-w-7xl px-4 pb-12 pt-6 sm:px-6 lg:px-8">
            #if(chrome.notice):
            <div class="mb-5 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status" data-admin-notice>
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7"/></svg>
                <span>#(chrome.notice)</span>
            </div>
            #endif
            <div id="admin-alert" aria-live="polite"></div>
            #import("body")
        </main>
    </div>
</div>

<dialog id="admin-confirm" aria-labelledby="admin-confirm-title" aria-describedby="admin-confirm-message" class="w-[min(28rem,calc(100vw-2rem))] rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50">
    <div class="p-6">
        <div class="flex gap-4">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-rose-100 text-rose-600">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
            </span>
            <div>
                <h2 id="admin-confirm-title" class="text-base font-semibold text-slate-900">Are you sure?</h2>
                <p class="mt-1 text-sm text-slate-600" id="admin-confirm-message"></p>
            </div>
        </div>
        <div class="mt-6 flex justify-end gap-2">
            <button type="button" id="admin-confirm-cancel" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
            <button type="button" id="admin-confirm-ok" class="rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-700">Yes, continue</button>
        </div>
    </div>
</dialog>
<script>
    // hx-confirm questions are shown in the dialog above instead of the
    // browser's own box. issueRequest(true) sends the request without the
    // browser box. Requests without a question pass straight through.
    // Added once: htmx re-runs body scripts when it restores a page from
    // its history cache (Back after a filter changed the address).
    if (!window.adminConfirmReady) {
    window.adminConfirmReady = true;
    document.body.addEventListener('htmx:confirm', function (evt) {
        var dialog = document.getElementById('admin-confirm');
        if (!evt.detail.question || !dialog || typeof dialog.showModal !== 'function') { return; }
        evt.preventDefault();
        document.getElementById('admin-confirm-message').textContent = evt.detail.question;
        var ok = document.getElementById('admin-confirm-ok');
        var cancel = document.getElementById('admin-confirm-cancel');
        function close() { ok.onclick = null; cancel.onclick = null; dialog.close(); }
        ok.onclick = function () { close(); evt.detail.issueRequest(true); };
        cancel.onclick = close;
        dialog.showModal();
    });
    }
</script>
</body>
</html>
