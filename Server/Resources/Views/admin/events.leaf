#extend("admin/layout"):
#export("body"):
<div class="mb-6">
    <div class="text-xs font-medium text-slate-400">Admin › #(chrome.section)</div>
    <h1 class="mt-0.5 text-2xl font-bold tracking-tight text-slate-900">Events</h1>
</div>
<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-wrap items-center gap-3 border-b border-slate-200 px-4 py-3">
        <form method="get" action="/admin/events" role="search" class="relative w-full sm:w-80">
            <label class="sr-only" for="admin-event-search">Search events</label>
            <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input id="admin-event-search" type="search" name="q" value="#(query)" maxlength="100" placeholder="Search title, city or venue" autocomplete="off"
                   class="w-full rounded-lg border border-slate-300 bg-white py-2 pl-9 pr-3 text-sm placeholder:text-slate-400 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
            <input type="hidden" name="filter" value="#(filter)">
        </form>
        <div class="flex flex-wrap gap-2">
            #for(chip in chips):
            #if(chip.isActive):
            <a href="#(chip.url)" aria-current="true" class="rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold text-white">#(chip.label) <span class="ml-1 opacity-60">#(chip.count)</span></a>
            #else:
            <a href="#(chip.url)" class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-50">#(chip.label) <span class="ml-1 opacity-60">#(chip.count)</span></a>
            #endif
            #endfor
        </div>
    </div>
    #if(isEmpty):
    <p class="px-4 py-12 text-center text-sm text-slate-400">No events match.</p>
    #else:
    <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
            <thead class="bg-slate-50 text-left text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                <tr>
                    <th scope="col" class="px-4 py-3">Event</th>
                    <th scope="col" class="px-4 py-3">Date</th>
                    <th scope="col" class="px-4 py-3">Host</th>
                    <th scope="col" class="px-4 py-3">City</th>
                    <th scope="col" class="px-4 py-3 text-right">Going</th>
                    <th scope="col" class="px-4 py-3">Status</th>
                    <th scope="col" class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                #for(event in events):
                <tr class="odd:bg-white even:bg-slate-50/70 hover:bg-teal-50/60" data-admin-event-row>
                    <td class="px-4 py-3">
                        <a href="#(event.url)" class="font-semibold text-slate-900 hover:text-teal-700">#(event.title)</a>
                        #if(event.isPrivate):
                        <span class="ml-1 inline-flex rounded-full bg-violet-50 px-2 py-0.5 text-[11px] font-semibold text-violet-700 ring-1 ring-inset ring-violet-600/25">Private</span>
                        #endif
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-slate-600">#eventDate(event.date, "short", event.timeZone)</td>
                    <td class="whitespace-nowrap px-4 py-3">
                        #if(event.hostURL):
                        <a href="#(event.hostURL)" class="text-slate-700 hover:text-teal-700">#(event.hostLabel)</a>
                        #else:
                        <span class="text-slate-700">#(event.hostLabel)</span>
                        #endif
                    </td>
                    <td class="max-w-[14rem] truncate px-4 py-3 text-slate-500">#(event.cityAddress)</td>
                    <td class="px-4 py-3 text-right tabular-nums text-slate-700">#(event.attendeeCount)</td>
                    <td class="whitespace-nowrap px-4 py-3"><span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset #(event.status.classes)">#(event.status.label)</span></td>
                    <td class="whitespace-nowrap px-4 py-3">
                        <div class="flex justify-end gap-1.5">
                            <a href="#(event.url)" title="View event" aria-label="View event: #(event.title)" class="grid h-8 w-8 place-items-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:bg-slate-50 hover:text-slate-900">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                            #if(event.canCancel):
                            <form method="post" action="#(event.cancelURL)" hx-post="#(event.cancelURL)"
                                  hx-confirm="Cancel this event? Attendees and chat are kept, but it can't be undone here.">
                                <input type="hidden" name="returnTo" value="#(returnURL)">
                                <button type="submit" title="Cancel event" aria-label="Cancel event: #(event.title)" class="grid h-8 w-8 place-items-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:border-rose-300 hover:bg-rose-50 hover:text-rose-600">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M9.5 13l5 5M14.5 13l-5 5"/></svg>
                                </button>
                            </form>
                            #endif
                        </div>
                    </td>
                </tr>
                #endfor
            </tbody>
        </table>
    </div>
    #endif
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-4 py-3 text-xs text-slate-500">
        <span>#(pager.showing)</span>
        #if(pager.hasPages):
        <div class="flex items-center gap-2">
            #if(pager.previousURL):
            <a href="#(pager.previousURL)" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-50">Previous</a>
            #endif
            <span>#(pager.pageLabel)</span>
            #if(pager.nextURL):
            <a href="#(pager.nextURL)" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-semibold text-slate-700 hover:bg-slate-50">Next</a>
            #endif
        </div>
        #endif
    </div>
</div>
#endexport
#endextend
