<div id="event-fragment" class="card ed-actions">
    #if(event.isCancelled):
    <p class="ed-cancelled" role="status">This event has been cancelled.</p>
    #endif
    <div class="ed-actions-row">
        <div class="ed-host-line">
            <span>Hosted by</span>
            #if(people.hostIsGroup):
            <img referrerpolicy="no-referrer" src="#groupLogoURL(event.hostPhotoURL)" alt="" class="ed-host-img" data-host-logo>
            #else:
            <img referrerpolicy="no-referrer" src="#avatarURL(event.hostPhotoURL)" alt="" class="ed-host-img">
            #endif
            #if(people.hostURL):
            <a href="#(people.hostURL)"><b>#(event.hostDisplayName)</b></a>
            #else:
            <b>#(event.hostDisplayName)</b>
            #endif
        </div>
        <div class="ed-action-buttons">
            #if(!event.isCancelled):
            #if(isSignedIn):
            #if(event.isRequesterAttending):
            <form hx-post="/events/#(event.id)/leave" hx-target="\#event-fragment" hx-swap="outerHTML"
                  hx-confirm="Leave this event?" data-confirm-ok="Leave event" data-confirm-cancel="Stay"
                  method="post" action="/events/#(event.id)/leave">
                <button type="submit" id="ed-rsvp" class="btn btn-going" aria-label="Going. Leave this event">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12.5 10 17.5 19 7.5"/></svg>Going
                </button>
            </form>
            #else:
            <form hx-post="/events/#(event.id)/join" hx-target="\#event-fragment" hx-swap="outerHTML"
                  method="post" action="/events/#(event.id)/join">
                <button type="submit" id="ed-rsvp" class="btn btn-accent">Join event</button>
            </form>
            #endif
            #else:
            <a href="/login" class="btn btn-accent">Sign in to join</a>
            #endif
            #if(canManage):
            <form hx-post="/events/#(event.id)/cancel" hx-target="\#event-fragment" hx-swap="outerHTML"
                  hx-confirm="Cancel this event?" data-confirm-detail="It stays listed, marked as cancelled." data-confirm-ok="Cancel event" data-confirm-cancel="Keep event"
                  method="post" action="/events/#(event.id)/cancel">
                <button type="submit" class="btn btn-danger-outline btn-sm">Cancel event</button>
            </form>
            #endif
            #endif
        </div>
    </div>
</div>
#if(isUpdate):
#extend("partials/event-attendees")
#endif
