<!--
  The part of the event-detail page that changes on join/leave/cancel
  (M4 acceptance criterion #6: "Join/leave updates the attendee list and
  count via htmx swap, no full reload"). Rendered two ways with the exact
  same context (`event`, `isSignedIn`, `canManage`):
    - inline, via \#extend from pages/event-detail.leaf, as part of the
      normal full-page render;
    - standalone, by EventWebController's join/leave/cancel handlers when
      the request came from htmx (identified by the HX-Request header) —
      that response replaces just this fragment in the DOM, via
      hx-target="\#event-fragment" hx-swap="outerHTML" below.
  Keep this the single source of truth for this markup — don't duplicate
  it back into event-detail.leaf.
-->
<div id="event-fragment">
    #if(event.isCancelled):
    <p class="mt-2 text-sm font-medium text-red-600">This event has been cancelled.</p>
    #endif

    <div class="mt-6 flex items-center gap-3">
        #if(isSignedIn):
            #if(event.isRequesterAttending):
            <form hx-post="/events/#(event.id)/leave" hx-target="\#event-fragment" hx-swap="outerHTML"
                  method="post" action="/events/#(event.id)/leave">
                <button type="submit" class="border border-gray-300 px-4 py-2 rounded-md text-sm hover:bg-gray-50">Leave</button>
            </form>
            #else:
            <form hx-post="/events/#(event.id)/join" hx-target="\#event-fragment" hx-swap="outerHTML"
                  method="post" action="/events/#(event.id)/join">
                <button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded-md text-sm hover:bg-gray-700">Join</button>
            </form>
            #endif
        #else:
            <a href="/login" class="bg-gray-900 text-white px-4 py-2 rounded-md text-sm hover:bg-gray-700">Sign in to join</a>
        #endif

        #if(canManage):
        <form hx-post="/events/#(event.id)/cancel" hx-target="\#event-fragment" hx-swap="outerHTML"
              hx-confirm="Cancel this event?"
              method="post" action="/events/#(event.id)/cancel" onsubmit="return confirm('Cancel this event?');">
            <button type="submit" class="text-sm text-red-600 hover:underline">Cancel event</button>
        </form>
        #endif
    </div>

    <h2 class="mt-8 text-lg font-medium">Attendees (#(count(event.attendees)))</h2>
    <ul class="mt-2 text-sm text-gray-600">
        #for(attendee in event.attendees):
        <li>#(attendee.displayName)</li>
        #endfor
    </ul>
</div>
