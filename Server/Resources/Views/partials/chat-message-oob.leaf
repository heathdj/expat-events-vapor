<!--
  One live chat message, sent to everyone in the room over the WebSocket
  (ChatWebController) and appended to \#chat-messages by htmx. For an
  hx-swap-oob like "beforeend:...", htmx inserts the CONTENTS of the
  element carrying the attribute, not the element itself (only outerHTML
  keeps it), so this outer div is a wrapper and the .chat-message inside
  it is what lands in the list (Event detail PR review; the M5 comment had
  this backwards). Same markup as the history loop in
  pages/event-detail.leaf: change both together. It's the same HTML for
  every reader, so js/event-chat.js marks your own messages.
-->
<div hx-swap-oob="beforeend:\#chat-messages"><div class="chat-message ed-msg#if(row.isReply): is-reply#endif" data-message-id="#(message.id)" data-user-id="#(message.userID)" data-thread-id="#(row.threadID)" data-name="#(message.displayName)">
    <img referrerpolicy="no-referrer" src="#avatarURL(message.photoURL)" alt="" class="ed-msg-avatar">
    <div class="ed-msg-main">
        <div class="ed-msg-meta"><b>#(message.displayName)</b><time datetime="#(row.isoTime)" data-local-time>#(row.fallbackTime)</time></div>
        #if(row.replyToName):
        <div class="ed-msg-replying">Replying to #(row.replyToName)</div>
        #endif
        <div class="ed-msg-bubble">#(message.text)</div>
        <button type="button" class="ed-msg-reply" data-reply aria-label="Reply to #(message.displayName)">Reply</button>
    </div>
</div></div>
