<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#(title) — ExpatEvents</title>
    <link rel="icon" type="image/png" href="/design/logo.png">
    <!--
      Theme foundation: the design canvas's app nav and footer, the real
      logo and default avatar, and the canvas tokens (colors, radius,
      shadow, Outfit) available to Tailwind as theme values, e.g.
      bg-app, text-ink, rounded-card, font-display. Tailwind still loads
      from the CDN (compiled build at M13, design audit section 0);
      htmx/Alpine likewise. design-tokens.css holds the canvas component
      classes (.card, .btn-*, .badge-*, .ds-*); app-theme.css the nav,
      footer and the extra button variants.
    -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        app: 'var(--bg)',
                        surface: 'var(--surface)',
                        'surface-2': 'var(--surface-2)',
                        ink: { DEFAULT: 'var(--ink)', soft: 'var(--ink-soft)', faint: 'var(--ink-faint)' },
                        line: 'var(--line)',
                        brand: { 1: 'var(--brand-1)', 2: 'var(--brand-2)', 3: 'var(--brand-3)' },
                        accent: { DEFAULT: 'var(--accent)', soft: 'var(--accent-soft)' },
                        gold: { DEFAULT: 'var(--gold)', soft: 'var(--gold-soft)' }
                    },
                    borderRadius: { field: 'var(--r-sm)', card: 'var(--r-md)', hero: 'var(--r-lg)' },
                    boxShadow: { card: 'var(--shadow-sm)', lift: 'var(--shadow-md)' },
                    fontFamily: { display: ['Outfit', 'system-ui', 'sans-serif'] }
                }
            }
        };
    </script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12/dist/ext/ws.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="stylesheet" href="/css/design-tokens.css">
    <link rel="stylesheet" href="/css/app-theme.css">
</head>
<body class="app-body min-h-screen flex flex-col" x-data="{ menu: false }" @keydown.escape.window="menu = false">
    <nav class="app-nav" aria-label="Main">
        <div class="app-nav-inner">
            <a href="/" class="app-brand"><img src="/design/logo.png" alt=""><span>ExpatEvents</span></a>
            <div class="app-nav-links">
                <a href="/events" class="app-nav-link #navActive("/events")">Events</a>
                <a href="/groups" class="app-nav-link #navActive("/groups")">Groups</a>
                #if(!isSignedIn):
                <a href="/\#pricing" class="app-nav-link">Pricing</a>
                #endif
            </div>
            <div class="app-nav-actions">
                #if(isSignedIn):
                <a href="/events/new" class="btn btn-solid-light btn-sm">+ Create Event</a>
                <div class="app-user" x-data="{ open: false }" @keydown.escape="open = false; $refs.pill.focus()" @click.outside="open = false" @focusout="if (!$el.contains($event.relatedTarget)) open = false">
                    <button type="button" class="user-pill" x-ref="pill" @click="open = !open" :aria-expanded="open.toString()" aria-expanded="false" aria-controls="app-user-menu">
                        <img referrerpolicy="no-referrer" src="#currentUser("avatar")" alt="">
                        <span class="user-pill-name">#currentUser("name")</span>
                        <svg class="icon" style="width:13px;height:13px" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div id="app-user-menu" class="app-menu" x-cloak x-show="open" x-transition.opacity>
                        <a href="/profile/#currentUser("id")" class="app-menu-item">Your profile</a>
                        <a href="/feed" class="app-menu-item">Feed</a>
                        <a href="/account" class="app-menu-item">Account</a>
                        #adminNavLink()
                        <div class="app-menu-divider" aria-hidden="true"></div>
                        <form method="post" action="/logout">
                            <button type="submit" class="app-menu-item">Sign out</button>
                        </form>
                    </div>
                </div>
                #else:
                <a href="/login" class="btn btn-ghost btn-sm">Sign in</a>
                #endif
            </div>
            <button type="button" class="app-nav-toggle" @click="menu = !menu" :aria-expanded="menu.toString()" aria-expanded="false" aria-controls="app-mobile-menu" aria-label="Menu">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
        <div id="app-mobile-menu" class="app-mobile-menu" x-cloak x-show="menu" x-transition.opacity>
            <a href="/events" class="app-nav-link #navActive("/events")">Events</a>
            <a href="/groups" class="app-nav-link #navActive("/groups")">Groups</a>
            #if(isSignedIn):
            <a href="/feed" class="app-nav-link #navActive("/feed")">Feed</a>
            <a href="/events/new" class="app-nav-link">+ Create Event</a>
            <a href="/profile/#currentUser("id")" class="app-nav-link">Your profile</a>
            <a href="/account" class="app-nav-link #navActive("/account")">Account</a>
            #adminNavLink("mobile")
            <form method="post" action="/logout">
                <button type="submit" class="app-nav-link">Sign out</button>
            </form>
            #else:
            <a href="/\#pricing" class="app-nav-link">Pricing</a>
            <a href="/login" class="app-nav-link">Sign in</a>
            #endif
        </div>
    </nav>
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 py-8">
        #import("body")
    </main>
    <footer class="app-footer">
        <div class="app-footer-inner">
            <div class="app-footer-grid">
                <div>
                    <h2>About us</h2>
                    <a href="/feedback">Feedback</a>
                    <a href="/privacy">Privacy policy</a>
                    <a href="/terms">Terms and conditions</a>
                </div>
                <div>
                    <h2>Services</h2>
                    <a href="/events">Events</a>
                    <a href="/groups">Groups</a>
                </div>
                <div>
                    <h2>ExpatEvents, a Bald Traveler site</h2>
                    <p class="app-footer-tagline">Building an expat community by helping you socialize with other expats.</p>
                </div>
            </div>
            <div class="app-footer-bottom">&copy; ExpatEvents. All rights reserved.</div>
        </div>
    </footer>
</body>
</html>
