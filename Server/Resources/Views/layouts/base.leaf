<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#(title) — ExpatEvents</title>
    <!--
      NOTE: this MVP scaffold loads Tailwind/htmx/Alpine from CDNs for
      speed of setup. Architecture §2/§15 calls for Tailwind compiled at
      build time via the CLI and htmx/Alpine/Flowbite vendored into
      /Public — swap these <script> tags for the compiled build before
      shipping past the MVP scaffold stage.
    -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12/dist/ext/ws.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <!--
      docs/design-system.md's tokens + a few reusable component classes
      (.card, .btn-*, .badge-*, .ds-*), added here so any page extending
      this layout can opt into them incrementally -- see
      Public/css/design-tokens.css's own header comment for what's
      copied verbatim from the canvas versus extrapolated, and
      MILESTONES.md's incremental-design-system-rollout note for why
      this isn't a full site reskin in one PR. Loading it here (global)
      rather than per-page is safe because it defines nothing but :root
      custom properties and specifically-named classes -- no bare
      element selectors -- so a page that never references those class
      names (still plain Tailwind, e.g. /events, /groups) renders
      identically to before this was added.
    -->
    <link rel="stylesheet" href="/css/design-tokens.css">
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    <nav class="bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between">
        <a href="/" class="font-semibold text-lg">ExpatEvents</a>
        <div class="flex items-center gap-4 text-sm">
            <a href="/events" class="hover:underline">Events</a>
            <a href="/groups" class="hover:underline">Groups</a>
            #if(isSignedIn):
            <a href="/feed" class="hover:underline">Feed</a>
            <a href="/account" class="hover:underline">Account</a>
            #adminNavLink()
            <form method="post" action="/logout" class="inline">
                <button type="submit" class="hover:underline">Sign out</button>
            </form>
            #else:
            <a href="/login" class="hover:underline">Sign in</a>
            #endif
        </div>
    </nav>
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 py-8">
        #import("body")
    </main>
    <!-- M9: every app page links to the legal pages and feedback, not
         just the marketing home page's footer. -->
    <footer class="border-t border-gray-200 bg-white px-4 py-4 text-sm text-gray-500">
        <div class="max-w-5xl mx-auto flex flex-wrap gap-4">
            <a href="/feedback" class="hover:underline">Feedback</a>
            <a href="/privacy" class="hover:underline">Privacy policy</a>
            <a href="/terms" class="hover:underline">Terms and conditions</a>
        </div>
    </footer>
</body>
</html>
