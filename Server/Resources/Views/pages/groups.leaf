#extend("layouts/base"):
#export("body"):
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">Groups</h1>
    #if(isSignedIn):
    <a href="/groups/new" class="bg-gray-900 text-white text-sm px-4 py-2 rounded-md hover:bg-gray-700">Start a group</a>
    #endif
</div>

<!--
  Only \#public groups are ever listed here -- see GroupService.publicGroups's
  doc comment for why invite-only groups are left out of the directory.
-->
<div class="grid gap-4">
    #for(group in groups):
    <a href="/groups/#(group.slug)" class="block bg-white border border-gray-200 rounded-lg p-4 hover:border-gray-400">
        <h2 class="font-medium">#(group.name)</h2>
        <p class="text-sm text-gray-500 mt-1">#(group.description)</p>
        <p class="text-sm text-gray-400 mt-1">#(group.memberCount) members — owned by #(group.ownerDisplayName)</p>
    </a>
    #endfor
    #if(count(groups) == 0):
    <p class="text-gray-500 text-sm">No public groups yet.</p>
    #endif
</div>
#endexport
#endextend
