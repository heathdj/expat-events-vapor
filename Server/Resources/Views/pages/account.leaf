#extend("layouts/base"):
#export("body"):
<!--
  M9 (/account). Styled from the design canvas's Account & billing
  artboard (Account.dc.html) via Public/css/design-tokens.css's
  ds-account-* rules -- profile card, plan pill and the two plan cards are
  that artboard's components. Left out on purpose: the monthly/yearly
  toggle, Upgrade/Cancel buttons, payment method row and billing history
  table, all Stripe-backed and waiting on M8. The "Your data" card has no
  canvas counterpart (see design-tokens.css).

  Every conditional below is a plain Bool/optional precomputed in
  AccountWebController -- no Leaf-side equality comparisons.
-->
<div class="ds-page-head">
    <h1>Account</h1>
    <p>Your profile, plan, and data.</p>
</div>

<div class="ds-account-layout">
    <div class="card ds-account-profile" x-data="{ editing: #(startEditing) }">
        <img referrerpolicy="no-referrer" src="#avatarURL(photoURL)" alt="" class="ds-avatar">
        <h4>#(displayName)</h4>
        <div class="ds-account-email">#(email)</div>
        <div class="ds-account-since">Member since #(memberSince)</div>
        #if(isPremium):
        <div class="ds-plan-pill ds-plan-premium">#(planLabel)</div>
        #else:
        <div class="ds-plan-pill ds-plan-free">#(planLabel)</div>
        #endif

        <button type="button" class="btn btn-outline" style="width:100%;" x-show="!editing" @click="editing = true">Edit profile</button>

        <form method="post" action="/account/profile" x-show="editing" x-cloak style="text-align:left;">
            #if(profileError):
            <div class="ds-alert ds-alert-error">#(profileError)</div>
            #endif
            <div class="ds-field">
                <label class="ds-label" for="displayName">Display name</label>
                <input class="ds-input" id="displayName" name="displayName" value="#(displayName)" maxlength="80" required>
            </div>
            <div style="display:flex;gap:8px;">
                <button type="submit" class="btn btn-accent btn-sm">Save</button>
                <button type="button" class="btn btn-outline btn-sm" @click="editing = false">Cancel</button>
            </div>
        </form>
    </div>

    <div>
        <div class="card ds-account-block" style="padding:24px 26px;">
            <div class="ds-section-title">Your plan</div>
            <div class="ds-plans-grid">
                #if(isPremium):
                <div class="card ds-plan-card">
                #else:
                <div class="card ds-plan-card ds-current">
                #endif
                    <div class="ds-plan-card-top">
                        <h3>Free</h3>
                        #if(!isPremium):
                        <span class="ds-current-tag">Current plan</span>
                        #endif
                    </div>
                    <div class="ds-plan-price"><b>$0</b><span>forever</span></div>
                    <ul class="ds-plan-feats">
                        <li><svg class="icon" viewBox="0 0 24 24"><polyline points="5 12.5 9.5 17 19 6.5"/></svg> Host up to 5 active events</li>
                        <li><svg class="icon" viewBox="0 0 24 24"><polyline points="5 12.5 9.5 17 19 6.5"/></svg> 5 attendees per event</li>
                        <li><svg class="icon" viewBox="0 0 24 24"><polyline points="5 12.5 9.5 17 19 6.5"/></svg> Public events only</li>
                    </ul>
                </div>
                #if(isPremium):
                <div class="card ds-plan-card ds-current">
                #else:
                <div class="card ds-plan-card">
                #endif
                    <div class="ds-plan-card-top">
                        <h3>Premium</h3>
                        #if(isPremium):
                        <span class="ds-current-tag">Current plan</span>
                        #endif
                    </div>
                    <div class="ds-plan-price"><b>$10</b><span>/ month, or $100 / year</span></div>
                    <ul class="ds-plan-feats">
                        <li><svg class="icon" viewBox="0 0 24 24"><polyline points="5 12.5 9.5 17 19 6.5"/></svg> Unlimited events &amp; attendees**</li>
                        <li><svg class="icon" viewBox="0 0 24 24"><polyline points="5 12.5 9.5 17 19 6.5"/></svg> Create a group to host events</li>
                        <li><svg class="icon" viewBox="0 0 24 24"><polyline points="5 12.5 9.5 17 19 6.5"/></svg> Recurring &amp; private events</li>
                    </ul>
                </div>
            </div>
            <p class="ds-plan-note">Changing plans isn't available yet. **100 attendees per event by default.</p>
        </div>

        <div class="card ds-account-block" style="padding:24px 26px;" id="photo">
            <div class="ds-section-title">Profile photo</div>
            #if(photoNotice):
            <div class="ds-alert ds-alert-success" role="status">#(photoNotice)</div>
            #endif
            #if(photoError):
            <div class="ds-alert ds-alert-error" role="alert" data-photo-error>#(photoError)</div>
            #endif
            <form method="post" action="/account/photo/source">
                <fieldset class="ds-photo-options">
                    <legend class="sr-only">Which photo to show</legend>
                    #for(option in photoOptions):
                    #if(option.isAvailable):
                    <label class="ds-photo-option">
                        #if(option.isSelected):
                        <input type="radio" name="source" value="#(option.value)" checked>
                        #else:
                        <input type="radio" name="source" value="#(option.value)">
                        #endif
                        <img referrerpolicy="no-referrer" src="#avatarURL(option.previewURL)" alt="" class="ds-avatar">
                        <span><b>#(option.label)</b><small>#(option.detail)</small></span>
                    </label>
                    #else:
                    <div class="ds-photo-option ds-photo-option-off">
                        <span class="ds-photo-radio-off" aria-hidden="true"></span>
                        <img referrerpolicy="no-referrer" src="#avatarURL(option.previewURL)" alt="" class="ds-avatar">
                        <span><b>#(option.label)</b><small>#(option.detail)</small></span>
                    </div>
                    #endif
                    #endfor
                </fieldset>
                <button type="submit" class="btn btn-accent btn-sm">Use this photo</button>
            </form>
            <div class="ds-photo-upload">
                <form method="post" action="/account/photo" enctype="multipart/form-data" x-data="{ tooBig: false }"
                      @submit="if ($refs.file.files[0] && $refs.file.files[0].size > 2097152) { $event.preventDefault(); tooBig = true }">
                    <label class="ds-label" for="photo-file">Upload a photo</label>
                    <p class="ds-hint">JPEG, PNG or WebP, up to 2 MB and 4096 pixels a side. It's shown as a circle. Location and camera details are removed.</p>
                    <div class="ds-alert ds-alert-error" role="alert" x-cloak x-show="tooBig">That photo is too large. The limit is 2 MB.</div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:8px;">
                        <input id="photo-file" type="file" name="photo" accept="image/jpeg,image/png,image/webp" required x-ref="file" @change="tooBig = false">
                        <button type="submit" class="btn btn-outline btn-sm">Upload</button>
                    </div>
                </form>
                #if(hasUpload):
                <form method="post" action="/account/photo/remove" hx-post="/account/photo/remove" hx-confirm="Remove your uploaded photo?" data-confirm-ok="Remove photo" style="margin-top:10px;">
                    <button type="submit" class="btn btn-danger-outline btn-sm">Remove uploaded photo</button>
                </form>
                #endif
            </div>
        </div>

        <div class="card ds-account-block" style="padding:24px 26px;" id="preferences">
            <div class="ds-section-title">Preferences</div>
            #if(preferencesNotice):
            <div class="ds-alert ds-alert-success" role="status" data-preferences-notice>#(preferencesNotice)</div>
            #endif
            <form method="post" action="/account/preferences">
                <fieldset style="border:0;margin:0;padding:0;">
                    <legend class="ds-label" style="padding:0;margin-bottom:8px;">Distances on the events page</legend>
                    <div style="display:flex;gap:18px;flex-wrap:wrap;">
                        #for(option in unitOptions):
                        <label style="display:inline-flex;align-items:center;gap:8px;font-size:14px;">
                            <input type="radio" name="distanceUnit" value="#(option.value)"#if(option.isSelected): checked#endif>
                            #(option.label)
                        </label>
                        #endfor
                    </div>
                </fieldset>
                <button type="submit" class="btn btn-outline btn-sm" style="margin-top:14px;">Save preferences</button>
            </form>
        </div>

        #extend("partials/account-data-fragment")
    </div>
</div>
#endexport
#endextend
