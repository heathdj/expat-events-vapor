#extend("layouts/base"):
#export("body"):
<div class="bg-white border border-gray-200 rounded-lg p-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-semibold">#(event.title)</h1>
        <span class="text-xs uppercase tracking-wide text-gray-500">#(event.category)</span>
    </div>
    #if(event.isCancelled):
    <p class="mt-2 text-sm font-medium text-red-600">This event has been cancelled.</p>
    #endif
    <p class="text-sm text-gray-500 mt-1">#(event.venueAddress)</p>
    <p class="text-sm text-gray-500">Hosted by #(event.hostDisplayName)</p>
    <p class="mt-4 text-gray-700">#(event.description)</p>

    <div class="mt-6 flex items-center gap-3">
        #if(isSignedIn):
            #if(event.isRequesterAttending):
            <form method="post" action="/events/#(event.id)/leave">
                <button type="submit" class="border border-gray-300 px-4 py-2 rounded-md text-sm hover:bg-gray-50">Leave</button>
            </form>
            #else:
            <form method="post" action="/events/#(event.id)/join">
                <button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded-md text-sm hover:bg-gray-700">Join</button>
            </form>
            #endif
        #else:
            <a href="/login" class="bg-gray-900 text-white px-4 py-2 rounded-md text-sm hover:bg-gray-700">Sign in to join</a>
        #endif

        #if(canManage):
        <form method="post" action="/events/#(event.id)/cancel" onsubmit="return confirm('Cancel this event?');">
            <button type="submit" class="text-sm text-red-600 hover:underline">Cancel event</button>
        </form>
        #endif
    </div>

    <h2 class="mt-8 text-lg font-medium">Attendees (#(count(event.attendees)))</h2>
    <ul class="mt-2 text-sm text-gray-600">
        #for(attendee in event.attendees):
        <li>#(attendee.displayName)</li>
        #endfor
    </ul>

    <!--
      Realtime chat (architecture §8, M5) is not yet built — this is where
      the htmx `ws-connect` element and message history will render.
    -->
</div>
#endexport
#endextend
